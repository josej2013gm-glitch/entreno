rules_version = '2';

// Reglas de seguridad de Cloud Firestore para la app de entrenamientos.
// Cada usuario solo puede leer y escribir dentro de users/{su uid}/...
// Pégalas en: Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // OPCIONAL (más estricto): permitir solo tu cuenta de Google.
      // Sustituye la línea anterior por esta y pon tu correo:
      // allow read, write: if request.auth != null && request.auth.uid == userId
      //                     && request.auth.token.email == "TU_CORREO@gmail.com";
    }
  }
}
